# Phapano+ environment variables
# Copy this file to .env.local and replace with your real Supabase credentials.
# The app is built to run with these placeholders without crashing.

NEXT_PUBLIC_SUPABASE_URL=placeholder
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder

# Server-only (never exposed to the browser). Used by the admin/service routes.
SUPABASE_SERVICE_ROLE_KEY=placeholder
