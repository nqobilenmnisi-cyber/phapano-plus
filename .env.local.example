# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and publishable (anon) key — safe to expose to the browser;
# access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional local UI demo. This flag is ignored outside development and must
# never be used as a substitute for real Supabase configuration in deployment.
# NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# ─── App URL ─────────────────────────────────────────────────────────────────
# The canonical base URL used in auth emails (verification links, etc.).
# Set this in Vercel → Project → Settings → Environment Variables:
#   Production:  https://plus.phapano.com
#   Local dev:   leave unset — localhost:3000 is used automatically.
# Production builds NEVER fall back to localhost even if this is unset.
NEXT_PUBLIC_SITE_URL=https://plus.phapano.com
